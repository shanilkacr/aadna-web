<cart-drawer class="cart-drawer" id="CartDrawer" aria-hidden="true">
  <div class="cart-drawer__overlay" data-cart-drawer-close></div>
  <div class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'general.cart.title' | t }}">
    <div class="cart-drawer__header">
      <p class="cart-drawer__title">{{ 'general.cart.title' | t }}</p>
      <button type="button" class="cart-drawer__close" data-cart-drawer-close aria-label="{{ 'general.cart.close' | t }}">{% render 'icon-close' %}</button>
    </div>

    <div class="cart-drawer__body">
      {%- if cart.item_count > 0 -%}
        <ul class="cart-drawer__items">
          {%- for item in cart.items -%}
            <li class="cart-drawer__item" data-cart-item-key="{{ item.key }}">
              <a href="{{ item.url }}" class="cart-drawer__item-media">
                {%- if item.image -%}
                  <img
                    src="{{ item.image | image_url: width: 200 }}"
                    alt="{{ item.image.alt | escape }}"
                    loading="lazy"
                    width="72"
                    height="90"
                  >
                {%- endif -%}
              </a>
              <div class="cart-drawer__item-info">
                <a href="{{ item.url }}" class="cart-drawer__item-title">{{ item.product.title }}</a>
                {%- if item.variant.title != 'Default Title' -%}
                  <p class="cart-drawer__item-variant">{{ item.variant.title }}</p>
                {%- endif -%}
                {%- for property in item.properties -%}
                  {%- unless property.last == blank -%}
                    <p class="cart-drawer__item-property">{{ property.first }}: {{ property.last }}</p>
                  {%- endunless -%}
                {%- endfor -%}
                <p class="cart-drawer__item-price">LKR {{ item.final_price | money_without_currency }}</p>
                <div class="cart-drawer__item-controls">
                  <div class="cart-drawer__qty">
                    <button type="button" class="cart-drawer__qty-btn" data-qty-minus aria-label="Decrease quantity">&#8722;</button>
                    <span class="cart-drawer__qty-num">{{ item.quantity }}</span>
                    <button type="button" class="cart-drawer__qty-btn" data-qty-plus aria-label="Increase quantity">&#43;</button>
                  </div>
                  <button type="button" class="cart-drawer__remove" data-cart-remove>Remove</button>
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <p class="cart-drawer__empty">{{ 'general.cart.empty' | t }}</p>
      {%- endif -%}
    </div>

    {%- if cart.item_count > 0 -%}
      <div class="cart-drawer__footer">
        <div class="cart-drawer__subtotal">
          <span>{{ 'general.cart.subtotal' | t }}</span>
          <span>LKR {{ cart.total_price | money_without_currency }}</span>
        </div>
        <a href="{{ routes.cart_url }}" class="button button--secondary">{{ 'general.cart.view_cart' | t }}</a>
        <a href="{{ routes.checkout_url | default: '/checkout' }}" class="button button--primary">{{ 'general.cart.checkout' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</cart-drawer>

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}
