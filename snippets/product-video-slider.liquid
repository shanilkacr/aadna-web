{%- comment -%}
  Swipeable strip of short portrait videos (main-product "video" blocks), shown on the Name Necklace page.
  Videos play muted and looping while they're on screen.
  Accepts: blocks (section.blocks), heading (string)
{%- endcomment -%}
{%- liquid
  assign video_count = 0
  for block in blocks
    if block.type == 'video' and block.settings.video != blank
      assign video_count = video_count | plus: 1
    endif
  endfor
-%}
{%- if video_count > 0 -%}
  <section class="product-videos page-width" data-product-videos>
    {%- if heading != blank -%}<h2 class="section-heading">{{ heading | escape }}</h2>{%- endif -%}
    <div class="product-videos__wrap">
      <button type="button" class="product-videos__arrow product-videos__arrow--prev" data-product-videos-prev aria-label="Previous videos">&lsaquo;</button>
      <div class="product-videos__track" data-product-videos-track>
        {%- for block in blocks -%}
          {%- if block.type == 'video' and block.settings.video != blank -%}
            {%- liquid
              assign video = block.settings.video
              assign video_src = ''
              for source in video.sources
                if source.mime_type == 'video/mp4' and source.height == 720
                  assign video_src = source.url
                endif
              endfor
              if video_src == ''
                for source in video.sources
                  if source.mime_type == 'video/mp4'
                    assign video_src = source.url
                    break
                  endif
                endfor
              endif
            -%}
            <div class="product-videos__item" {{ block.shopify_attributes }}>
              <video
                src="{{ video_src }}"
                {% if video.preview_image %}poster="{{ video.preview_image | image_url: width: 480 }}"{% endif %}
                muted
                loop
                playsinline
                preload="none"
                aria-label="{{ video.alt | default: 'Name necklace video' | escape }}"
              ></video>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <button type="button" class="product-videos__arrow product-videos__arrow--next" data-product-videos-next aria-label="Next videos">&rsaquo;</button>
    </div>
  </section>
{%- endif -%}
