{%- comment -%}
  Live 3D name-necklace preview (three.js). Used on the Name Necklace product page.
  Parts:
    stage  - the 3D canvas (rendered at the top of the media column) + script + @font-face
    fonts  - the font picker (rendered inside the personalization block of the form)
  Fonts live in assets/nnp-*.woff (Latin subsets; only fonts licensed for commercial web use). Add a font by dropping a .woff
  in assets and adding a line to the list below.
{%- endcomment -%}
{%- liquid
  assign nnp_ids = 'armelie|runethia|hugh-is-life|blenda-script|libre-baskerville|jost' | split: '|'
  assign nnp_labels = 'Armelie|Runethia|Hugh is Life|Blenda Script|Libre Baskerville|Jost' | split: '|'
-%}

{%- if part == 'stage' -%}
  {%- capture nnp_json -%}
    [
    {%- for id in nnp_ids -%}
      {%- assign label = nnp_labels[forloop.index0] -%}
      {%- assign file = 'nnp-' | append: id | append: '.woff' -%}
      {"id":"{{ id }}","label":"{{ label }}","url":"{{ file | asset_url }}"
      {%- if id == 'armelie' -%},"tracking":-0.02,"depth":0.05{%- endif -%}
      {%- if id == 'runethia' -%},"tracking":-0.02,"depth":0.05,"photoScale":1.5{%- endif -%}
      {%- if id == 'hugh-is-life' -%},"tracking":-0.01,"depth":0.06,"scale":1.55,"photoScale":1.55{%- endif -%}
      {%- if id == 'blenda-script' -%},"tracking":-0.01,"depth":0.06,"photoScale":1.65{%- endif -%}
      {%- if id == 'libre-baskerville' -%},"tracking":0.02,"depth":0.075,"photoScale":1.3{%- endif -%}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
    ]
  {%- endcapture -%}
  <style>
    {%- for id in nnp_ids -%}
      @font-face { font-family: 'NNP {{ id }}'; src: url('{{ 'nnp-' | append: id | append: '.woff' | asset_url }}') format('woff'); font-display: swap; }
    {%- endfor -%}
  </style>
  <div
    class="nnp-stage"
    data-nnp-stage
    data-nnp-mode="{{ mode | default: 'name' }}"
    data-coin-style="{{ coin_style | default: 'rope' }}"
    {% if mode == 'coin' %}data-placeholder="Engrave here" data-default-font="libre-baskerville"{% endif %}
    {% if mode == 'bracelet' %}data-placeholder="&ldquo;Engrave here&rdquo;" data-default-font="runethia"{% endif %}
    {% if mode == 'ring' %}data-ring-style="{{ ring_style }}" data-default-font="{% if ring_style == 'letter' %}jost{% else %}libre-baskerville{% endif %}"{% if ring_style == 'studded-oval' %} data-placeholder="A" data-sample="A"{% elsif ring_style == 'cushion' %} data-placeholder="k." data-sample="k."{% elsif ring_style == 'letter' %} data-placeholder="A" data-sample="A"{% else %} data-placeholder="Engrave here"{% endif %}{% endif %}
    {% if mode == 'cufflinks' %}data-placeholder="BR" data-sample="BR" data-default-font="libre-baskerville"{% endif %}
    data-fonts='{{ nnp_json | strip_newlines | escape_once }}'
    {% if mode == 'name' or mode == 'coin' %}
      data-nnp-photo="true"
      style="background-image: url('{{ 'nnp-neck.webp' | asset_url }}');"
    {% elsif section.settings.name_preview_background != blank %}
      style="background-image: url('{{ section.settings.name_preview_background | image_url: width: 1400 }}');"
    {% endif %}
  >
    <canvas data-nnp-canvas aria-label="Live 3D preview of your necklace" role="img"></canvas>
    {%- if mode == 'bracelet' or mode == 'cufflinks' or mode == 'ring' -%}
      <button type="button" class="nnp-view-toggle" data-nnp-view-toggle aria-pressed="false">Close-up</button>
    {%- endif -%}
  </div>
  <p class="nnp-caption">
    {%- if mode == 'coin' -%}
      Live preview &mdash; your engraving appears on the coin as you type (the coin is 1.8&ndash;2cm across). Finish and lettering of the final piece may vary slightly.
    {%- elsif mode == 'ring' and ring_style == 'letter' -%}
      Live preview &mdash; shows the first letter you type on the ring (use Close-up for detail). Finish and lettering of the final piece may vary slightly.
    {%- elsif mode == 'ring' -%}
      Live preview &mdash; your engraving appears on the ring as you type (use Close-up for detail). Finish and lettering of the final piece may vary slightly.
    {%- elsif mode == 'cufflinks' -%}
      Live preview &mdash; your initials appear on the cufflinks as you type (the pair is identical; use Close-up for detail). Finish and lettering of the final piece may vary slightly.
    {%- elsif mode == 'bracelet' -%}
      Live preview &mdash; your engraving appears on the bar as you type (use Close-up for detail). Finish and lettering of the final piece may vary slightly.
    {%- else -%}
      Live preview &mdash; updates as you type. Finish and lettering of the final piece may vary slightly.
    {%- endif -%}
  </p>
  <script src="{{ 'name-necklace-preview.js' | asset_url }}" defer></script>
{%- endif -%}

{%- if part == 'fonts' -%}
  <div class="nnp-fonts-wrap">
    <span class="nnp-fonts-label" id="NnpFontsLabel">Select font</span>
    <div class="nnp-fonts" role="radiogroup" aria-labelledby="NnpFontsLabel" data-nnp-fonts>
      {%- for id in nnp_ids -%}
        {%- if id == 'jost' -%}{%- continue -%}{%- endif -%}
        <button
          type="button"
          role="radio"
          aria-checked="false"
          class="nnp-font"
          data-nnp-font="{{ id }}"
          aria-label="{{ nnp_labels[forloop.index0] }}"
          style="font-family: 'NNP {{ id }}', serif;"
        ><span data-nnp-sample>Name</span></button>
      {%- endfor -%}
    </div>
    <input type="hidden" name="properties[Font]" value="{{ nnp_labels[0] }}" data-nnp-font-field>
  </div>
{%- endif -%}
