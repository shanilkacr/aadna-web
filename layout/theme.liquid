<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta name="google-site-verification" content="qZtmvyIJlyO8_1gZ4nBbcn2-YsGOGeA88u_NFb3D8Qg" />
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="canonical" href="{{ canonical_url }}">
  {% if settings.favicon %}
    <link rel="icon" type="image/png" sizes="32x32" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    <link rel="icon" type="image/png" sizes="16x16" href="{{ settings.favicon | image_url: width: 16, height: 16 }}">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
  {% else %}
    <link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-32x32.png' | asset_url }}">
    <link rel="icon" type="image/png" sizes="16x16" href="{{ 'favicon-16x16.png' | asset_url }}">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ 'apple-touch-icon.png' | asset_url }}">
  {% endif %}

  <title>
    {{ page_title }}
    {%- if request.page_type == 'product' and page_title == product.title -%}
      {%- for col in product.collections -%}
        {%- if col.handle == 'personalised-jewellery' -%}
          {%- assign _title_in_personalised = true -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if _title_in_personalised %} | Personalised Jewellery Sri Lanka{%- endif -%}
    {%- endif -%}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {%- if request.page_type == 'product' -%}
    {%- comment -%} Use manually set SEO description if available, otherwise auto-generate a keyword-rich one {%- endcomment -%}
    {%- if product.metafields.global.description_tag != blank -%}
      <meta name="description" content="{{ product.metafields.global.description_tag | escape }}">
    {%- else -%}
      {%- assign _desc_in_personalised = false -%}
      {%- for col in product.collections -%}
        {%- if col.handle == 'personalised-jewellery' -%}
          {%- assign _desc_in_personalised = true -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if _desc_in_personalised -%}
        {%- assign _auto_desc = product.title | append: ' – Personalised jewellery handcrafted in 925 sterling silver with 22k gold plated or rhodium finish. Made to order in Sri Lanka by AADNA.' -%}
      {%- else -%}
        {%- assign _auto_desc = product.title | append: ' – Handcrafted in 925 sterling silver with 22k gold plated or rhodium finish. Made to order in Sri Lanka by AADNA.' -%}
      {%- endif -%}
      <meta name="description" content="{{ _auto_desc | escape }}">
    {%- endif -%}
  {%- elsif page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  {% render 'meta-tags' %}
  {% render 'schema-organization' %}
  {%- if request.page_type == 'page' and page.handle == 'faq' -%}{% render 'schema-faq' %}{%- endif -%}

  {{ content_for_header }}

  {{ 'forum-regular.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {{ 'stack-sans-headline-extralight.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}

  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <style>
    :root{
      --color-background: {{ settings.color_background }};
      --color-background-alt: {{ settings.color_background_alt }};
      --color-text: {{ settings.color_text }};
      --color-text-muted: {{ settings.color_text_muted }};
      --color-accent: {{ settings.color_accent }};
      --color-border: {{ settings.color_border }};
      --color-button-background: {{ settings.color_button_background }};
      --color-button-text: {{ settings.color_button_text }};
      --font-heading: serif;
      --font-body: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
      --font-body-weight: {{ settings.font_body.weight }};
      --page-width: {{ settings.page_width }}px;
      --spacing-sections: {{ settings.spacing_sections }}px;
      --grid-gap: {{ settings.grid_gap }}px;
      --button-radius: {{ settings.button_border_radius }}px;
      --header-logo-width: {{ settings.logo_width }}px;
    }
  </style>
</head>
<body{% if template.name == 'index' %} class="has-hero"{% elsif template == 'page.contact' %} class="has-contact-page"{% elsif template == 'page.sizing-chart' %} class="has-sizing-chart-page"{% elsif template == 'page.our-story' %} class="has-story-page"{% elsif template == 'page.design-your-own' %} class="has-design-your-own-page"{% endif %}>
  <a class="skip-to-content" href="#MainContent">Skip to content</a>

  {% sections 'header-group' %}

  {% render 'search-overlay' %}

  <main id="MainContent" role="main" data-page-content>
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}
//floating whatsapp chat intergration
<style>
  #aadna-whatsapp {
    font-family: Arial, sans-serif;
  }

  #aadna-whatsapp .wa-button {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 999999;
    width: 60px;
    height: 60px;
    border: none;
    border-radius: 50%;
    background: #25D366;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 15px #0003;
  }

  #aadna-whatsapp .wa-button svg {
    width: 34px;
    height: 34px;
  }

  #aadna-whatsapp .wa-panel {
    position: fixed;
    right: 24px;
    bottom: 96px;
    width: min(340px, calc(100vw - 32px));
    background: white;
    border-radius: 16px;
    overflow: hidden;
    z-index: 999999;
    box-shadow: 0 8px 30px #0003;
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    transition: .25s ease;
  }

  #aadna-whatsapp .wa-panel.open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  #aadna-whatsapp .wa-header {
    background: #075E54;
    color: white;
    padding: 18px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  #aadna-whatsapp .wa-avatar {
    width: 42px;
    height: 42px;
    background: #25D366;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 23px;
  }

  #aadna-whatsapp .wa-heading {
    flex: 1;
  }

  #aadna-whatsapp .wa-heading strong {
    display: block;
    font-size: 15px;
  }

  #aadna-whatsapp .wa-heading small {
    font-size: 12px;
    opacity: .85;
  }

  #aadna-whatsapp .wa-close {
    background: transparent;
    color: white;
    border: 0;
    font-size: 25px;
    cursor: pointer;
  }

  #aadna-whatsapp .wa-content {
    background: #f5f7f6;
    padding: 20px;
  }

  #aadna-whatsapp .wa-message {
    background: white;
    padding: 14px;
    border-radius: 4px 14px 14px;
    font-size: 14px;
    line-height: 1.6;
    color: #333;
  }

  #aadna-whatsapp .wa-chat {
    display: block;
    margin-top: 18px;
    padding: 14px;
    background: #25D366;
    color: #064b29;
    border-radius: 30px;
    text-decoration: none;
    text-align: center;
    font-weight: bold;
    font-size: 14px;
  }

  #aadna-whatsapp .wa-chat:hover {
    background: #1ebe5d;
  }

  #aadna-whatsapp .wa-note {
    margin-top: 12px;
    text-align: center;
    font-size: 11px;
    color: #777;
  }

  @media(max-width: 480px) {
    #aadna-whatsapp .wa-button {
      right: 16px;
      bottom: 18px;
    }

    #aadna-whatsapp .wa-panel {
      right: 16px;
      bottom: 90px;
    }
  }

  
/* Keep popup message in normal sentence case */
#aadna-whatsapp .wa-message {
  text-transform: none !important;
  text-align: left;
  font-size: 14px;
  line-height: 1.7;
}

@media(prefers-reduced-motion: reduce) {
  #aadna-whatsapp .wa-panel {
    transition: none;
  }
}

</style>

<div id="aadna-whatsapp">

  <div class="wa-panel" id="aadna-wa-panel"
       role="dialog" aria-label="WhatsApp chat"
       aria-hidden="true">

    <div class="wa-header">
      <div class="wa-avatar">☏</div>

      <div class="wa-heading">
        <strong>AADNA Customer Support</strong>
        <small>We're here to help!</small>
      </div>

      <button class="wa-close" id="aadna-wa-close"
              aria-label="Close chat">&times;</button>
    </div>

    <div class="wa-content">
      <div class="wa-message">
  Hello! 👋

  Thinking of purchasing something beautiful
  from AADNA?

  Have questions or need more details before
  placing your order? We'd love to help you
  make the perfect choice. ❤️

  Feel free to reach out to us!
</div>

      <a href="#" class="wa-chat" id="aadna-wa-link"
         target="_blank" rel="noopener noreferrer">
        Chat with us on WhatsApp →
      </a>

      <div class="wa-note">
        AADNA Jewellery | Customer Support
      </div>
    </div>

  </div>

  <button class="wa-button" id="aadna-wa-toggle"
          aria-label="Open WhatsApp chat"
          aria-expanded="false"
          aria-controls="aadna-wa-panel">

    <svg viewBox="0 0 32 32" fill="currentColor"
         aria-hidden="true">
      <path d="M16 .8A15 15 0 0 0 3.1 23.5L1 31l7.7-2A15.1 15.1 0 1 0 16 .8Zm0 27.4c-2.4 0-4.7-.7-6.7-1.9l-.5-.3-4.6 1.2 1.2-4.5-.3-.5A12.3 12.3 0 1 1 16 28.2Zm6.8-9.2c-.4-.2-2.1-1-2.5-1.1-.3-.1-.6-.2-.8.2-.3.4-.9 1.1-1.1 1.3-.2.2-.4.3-.8.1-2.2-1.1-3.7-2-5.2-4.5-.4-.6.4-.6 1-1.9.1-.3 0-.5-.1-.7l-1.1-2.6c-.3-.7-.6-.6-.9-.6h-.7c-.3 0-.7.1-1 .5-.4.4-1.3 1.3-1.3 3.1s1.3 3.5 1.5 3.8c.2.2 2.6 4 6.3 5.5 2.3.9 3.2 1 4.3.8.7-.1 2.1-.9 2.4-1.8.3-.9.3-1.6.2-1.8-.1-.2-.4-.3-.8-.5Z"/>
    </svg>

  </button>
</div>

<script>


(function() {
  const root = document.getElementById('aadna-whatsapp');
  if (!root || root.dataset.ready) return;
  root.dataset.ready = 'true';

  const whatsappNumber = '94778809890';

  const panel = root.querySelector('#aadna-wa-panel');
  const toggle = root.querySelector('#aadna-wa-toggle');
  const close = root.querySelector('#aadna-wa-close');
  const link = root.querySelector('#aadna-wa-link');

  function openPanel(open) {
    panel.classList.toggle('open', open);
    panel.setAttribute('aria-hidden', String(!open));
    toggle.setAttribute('aria-expanded', String(open));
  }

  toggle.addEventListener('click', function() {
    openPanel(!panel.classList.contains('open'));
  });

  close.addEventListener('click', function() {
    openPanel(false);
    toggle.focus();
  });

  link.addEventListener('click', function(event) {
    event.preventDefault();

    const productTitle = {{ product.title | default: '' | json }};
    const productUrl = {{ product.url | default: '' | json }};
    const pageType = {{ request.page_type | json }};

    let message;

    if (pageType === 'product' && productTitle && productUrl) {
      message =
        'Hey there! Just checking this on the website. ' +
        'Would like to know more.\n\n' +
        'Product: ' + productTitle + '\n\n' +
        'Product URL: ' + window.location.origin + productUrl;

    } else if (
      pageType === 'collection' &&
      window.location.pathname === '/collections/all'
    ) {
      message =
        'Hi AADNA! I am browsing your All Products collection. ' +
        'I would like to know more about your jewellery.\n\n' +
        'Collection URL: https://aadna.store/collections/all?sort_by=created-descending';

    } else {
      message =
        'Hi AADNA! I am browsing your website. ' +
        'Can you share more details about your jewellery?\n\n' +
        'Website URL: ' + window.location.href;
    }

    const whatsappUrl =
      'https://wa.me/' + whatsappNumber +
      '?text=' + encodeURIComponent(message);

    window.open(whatsappUrl, '_blank', 'noopener,noreferrer');
  });

  document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') openPanel(false);
  });
})();


</script>

  {% if settings.cart_type == 'drawer' %}
    {% section 'cart-drawer' %}
  {% endif %}

  <script>
    window.Shopify = window.Shopify || {};
    window.Shopify.currency = { active: {{ cart.currency.iso_code | json }}, rate: '1.0' };
    window.Shopify.money_format = {{ shop.money_format | json }};
  </script>
  <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
</body>
</html>
