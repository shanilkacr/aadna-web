<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta name="google-site-verification" content="qZtmvyIJlyO8_1gZ4nBbcn2-YsGOGeA88u_NFb3D8Qg" />
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="canonical" href="{{ canonical_url }}">
  {% if settings.favicon %}
    <link rel="icon" type="image/png" sizes="32x32" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    <link rel="icon" type="image/png" sizes="16x16" href="{{ settings.favicon | image_url: width: 16, height: 16 }}">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
  {% else %}
    <link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-32x32.png' | asset_url }}">
    <link rel="icon" type="image/png" sizes="16x16" href="{{ 'favicon-16x16.png' | asset_url }}">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ 'apple-touch-icon.png' | asset_url }}">
  {% endif %}

  <title>
    {{ page_title }}
    {%- if request.page_type == 'product' and page_title == product.title -%}
      {%- for col in product.collections -%}
        {%- if col.handle == 'personalised-jewellery' -%}
          {%- assign _title_in_personalised = true -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if _title_in_personalised %} | Personalised Jewellery Sri Lanka{%- endif -%}
    {%- endif -%}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {%- if request.page_type == 'product' -%}
    {%- comment -%} Use manually set SEO description if available, otherwise auto-generate a keyword-rich one {%- endcomment -%}
    {%- if product.metafields.global.description_tag != blank -%}
      <meta name="description" content="{{ product.metafields.global.description_tag | escape }}">
    {%- else -%}
      {%- assign _desc_in_personalised = false -%}
      {%- for col in product.collections -%}
        {%- if col.handle == 'personalised-jewellery' -%}
          {%- assign _desc_in_personalised = true -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if _desc_in_personalised -%}
        {%- assign _auto_desc = product.title | append: ' – Personalised jewellery handcrafted in 925 sterling silver with 22k gold plated or rhodium finish. Made to order in Sri Lanka by AADNA.' -%}
      {%- else -%}
        {%- assign _auto_desc = product.title | append: ' – Handcrafted in 925 sterling silver with 22k gold plated or rhodium finish. Made to order in Sri Lanka by AADNA.' -%}
      {%- endif -%}
      <meta name="description" content="{{ _auto_desc | escape }}">
    {%- endif -%}
  {%- elsif page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  {% render 'meta-tags' %}
  {% render 'schema-organization' %}
  {%- if request.page_type == 'page' and page.handle == 'faq' -%}{% render 'schema-faq' %}{%- endif -%}

  {{ content_for_header }}

  {{ 'forum-regular.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {{ 'stack-sans-headline-extralight.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}

  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <style>
    :root{
      --color-background: {{ settings.color_background }};
      --color-background-alt: {{ settings.color_background_alt }};
      --color-text: {{ settings.color_text }};
      --color-text-muted: {{ settings.color_text_muted }};
      --color-accent: {{ settings.color_accent }};
      --color-border: {{ settings.color_border }};
      --color-button-background: {{ settings.color_button_background }};
      --color-button-text: {{ settings.color_button_text }};
      --font-heading: serif;
      --font-body: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
      --font-body-weight: {{ settings.font_body.weight }};
      --page-width: {{ settings.page_width }}px;
      --spacing-sections: {{ settings.spacing_sections }}px;
      --grid-gap: {{ settings.grid_gap }}px;
      --button-radius: {{ settings.button_border_radius }}px;
      --header-logo-width: {{ settings.logo_width }}px;
    }
  </style>
</head>
<body{% if template.name == 'index' %} class="has-hero"{% elsif template == 'page.contact' %} class="has-contact-page"{% elsif template == 'page.sizing-chart' %} class="has-sizing-chart-page"{% elsif template == 'page.our-story' %} class="has-story-page"{% elsif template == 'page.design-your-own' %} class="has-design-your-own-page"{% endif %}>
  <a class="skip-to-content" href="#MainContent">Skip to content</a>

  {% sections 'header-group' %}

  {% render 'search-overlay' %}

  <main id="MainContent" role="main" data-page-content>
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {% if settings.cart_type == 'drawer' %}
    {% section 'cart-drawer' %}
  {% endif %}

  <script>
    window.Shopify = window.Shopify || {};
    window.Shopify.currency = { active: {{ cart.currency.iso_code | json }}, rate: '1.0' };
    window.Shopify.money_format = {{ shop.money_format | json }};
  </script>
  <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
</body>
</html>
